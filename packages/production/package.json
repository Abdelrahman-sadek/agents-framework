{
  "name": "@agent-framework/production",
  "version": "0.1.0",
  "description": "Production runtime: durable run state (PostgreSQL, SQLite), durable job queue, workers with leases, recovery and graceful shutdown, agent service API, health checks, validated framework configuration",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project production",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@agent-framework/core": "workspace:*",
    "@agent-framework/tools": "workspace:*",
    "zod": "^4.1.0",
    "@agent-framework/knowledge": "workspace:*",
    "@agent-framework/memory": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdelrahman-sadek/agents-framework.git",
    "directory": "packages/production"
  },
  "homepage": "https://github.com/Abdelrahman-sadek/agents-framework#readme",
  "publishConfig": {
    "access": "public"
  }
}
