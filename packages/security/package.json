{
  "name": "@agent-framework/security",
  "version": "0.1.0",
  "description": "Security: guardrails (PII, prompt injection, content, secrets), RBAC/ABAC and tenant policies, SSRF-safe egress and HTTP tools, secrets, identity mapping",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project security",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@agent-framework/core": "workspace:*",
    "@agent-framework/tools": "workspace:*",
    "zod": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdelrahman-sadek/agents-framework.git",
    "directory": "packages/security"
  },
  "homepage": "https://github.com/Abdelrahman-sadek/agents-framework#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "llm",
    "typescript",
    "agent-framework",
    "guardrails",
    "prompt-injection",
    "pii",
    "rbac",
    "ssrf"
  ]
}
