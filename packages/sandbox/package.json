{
  "name": "@agent-farmework/sandbox",
  "version": "0.1.0",
  "description": "Sandbox-backed tools: workspace-confined filesystem access and allow-listed command execution",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project sandbox",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@agent-farmework/core": "workspace:*",
    "@agent-farmework/tools": "workspace:*",
    "zod": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-farmework/agents-framework.git",
    "directory": "packages/sandbox"
  },
  "homepage": "https://github.com/agent-farmework/agents-framework#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "llm",
    "typescript",
    "agent-framework",
    "sandbox",
    "code-execution"
  ]
}
