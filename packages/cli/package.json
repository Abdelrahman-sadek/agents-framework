{
  "name": "@agent-farmework/cli",
  "version": "0.1.0",
  "description": "Developer CLI (create, dev, test, evaluate, inspect, trace, validate) and declarative agent manifests",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project cli",
    "prepublishOnly": "tsc -b"
  },
  "bin": {
    "agent": "./bin/agent.js"
  },
  "dependencies": {
    "@agent-farmework/core": "workspace:*",
    "@agent-farmework/evaluation": "workspace:*",
    "@agent-farmework/observability": "workspace:*",
    "@agent-farmework/production": "workspace:*",
    "@agent-farmework/tools": "workspace:*",
    "zod": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-farmework/agents-framework.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/agent-farmework/agents-framework#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "llm",
    "typescript",
    "agent-framework",
    "cli"
  ]
}
