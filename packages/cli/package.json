{
  "name": "@agent-framework/cli",
  "version": "0.1.0",
  "description": "Developer CLI (create, dev, test, evaluate, inspect, trace, validate) and declarative agent manifests",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. --project cli"
  },
  "bin": {
    "agent": "./bin/agent.js"
  },
  "dependencies": {
    "@agent-framework/core": "workspace:*",
    "@agent-framework/evaluation": "workspace:*",
    "@agent-framework/observability": "workspace:*",
    "@agent-framework/production": "workspace:*",
    "@agent-framework/tools": "workspace:*",
    "zod": "^4.1.0"
  }
}
