{
  "name": "@agent-framework/core",
  "version": "0.1.0",
  "description": "Deterministic agent runtime: agent definition, run loop, state, events, errors, limits, and provider/tool/decision/context ports",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -b",
