  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdelrahman-sadek/agents-framework.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Abdelrahman-sadek/agents-framework#readme",
